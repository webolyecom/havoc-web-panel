#!/bin/sh
# Havoc cron output wrapper. Runs as the hosting user (from its crontab):
#   havoc-cronwrap <logfile> <command>
# Appends a timestamped header, the command's output and its exit code to <logfile>, keeping the file under ~1 MB.
log=$1
cmd=$2
[ -n "$log" ] && [ -n "$cmd" ] || exit 64
umask 077
mkdir -p "$(dirname "$log")" || exit 1
if [ -f "$log" ] && [ "$(wc -c < "$log")" -gt 1048576 ]; then
  tail -n 2000 "$log" > "$log.tmp" && mv -f "$log.tmp" "$log"
fi
{
  echo "=== $(date '+%Y-%m-%d %H:%M:%S %Z') ==="
  /bin/sh -c "$cmd"
  rc=$?
  echo "=== exit $rc ==="
} >> "$log" 2>&1
exit 0
