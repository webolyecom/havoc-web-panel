#!/bin/bash
# Installs (or updates) phpMyAdmin from phpmyadmin.net for Havoc WEB Panel. Started by `havocctl pma.install` via systemd-run.
set -euo pipefail
umask 022
DIR=/opt/havoc-pma
STATE=/var/lib/havoc-pma

# PHP for phpMyAdmin: prefer 8.3 (best tested with phpMyAdmin 5.2), needs php-fpm + mysqli
PHPV=""
for v in 8.3 8.2 8.4 8.1; do
  if [ -x "/usr/sbin/php-fpm$v" ] && [ -f "/etc/php/$v/mods-available/mysqli.ini" ]; then PHPV=$v; break; fi
done
[ -n "$PHPV" ] || { echo "No PHP-FPM version with the mysqli extension is installed (apt install php8.3-fpm php8.3-mysql)"; exit 1; }
for ext in mbstring xml zip; do
  [ -f "/etc/php/$PHPV/mods-available/$ext.ini" ] || echo "Note: php$PHPV-$ext is not installed; some phpMyAdmin features will be limited."
done
echo "Using PHP $PHPV."

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
BASE=https://files.phpmyadmin.net/phpMyAdmin
echo "Looking up the latest phpMyAdmin release..."
VER=$(curl -fsSL --proto '=https' --tlsv1.2 https://www.phpmyadmin.net/home_page/version.txt 2>/dev/null | head -1 | tr -d '[:space:]' || true)
if [[ "$VER" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  PKG="phpMyAdmin-$VER-all-languages.tar.gz"; URL="$BASE/$VER/$PKG"
else
  VER=latest; PKG="phpMyAdmin-latest-all-languages.tar.gz"; URL="https://www.phpmyadmin.net/downloads/$PKG"
fi
echo "Downloading phpMyAdmin $VER..."
curl -fsSL --proto '=https' --tlsv1.2 -o "$tmp/$PKG" "$URL"
curl -fsSL --proto '=https' --tlsv1.2 -o "$tmp/$PKG.sha256" "$URL.sha256"
( cd "$tmp" && echo "$(awk '{print $1}' "$PKG.sha256")  $PKG" | sha256sum -c - ) || { echo "SHA-256 mismatch, aborting"; exit 1; }
mkdir "$tmp/x" && tar -xzf "$tmp/$PKG" -C "$tmp/x" --strip-components=1 --no-same-owner
[ -f "$tmp/x/index.php" ] || { echo "Unexpected package layout"; exit 1; }
rm -rf "$tmp/x/setup" "$tmp/x/examples" "$tmp/x/test" 2>/dev/null || true

id havoc-pma >/dev/null 2>&1 || useradd --system --home-dir "$STATE" --shell /usr/sbin/nologin havoc-pma
install -d -o havoc-pma -g havoc-pma -m 750 "$STATE" "$STATE/tmp" "$STATE/sessions"
SECRET_FILE="$STATE/blowfish"
[ -s "$SECRET_FILE" ] || { openssl rand -hex 16 > "$SECRET_FILE"; chown root:havoc-pma "$SECRET_FILE"; chmod 640 "$SECRET_FILE"; }
SECRET=$(cat "$SECRET_FILE")

cat > "$tmp/x/config.inc.php" <<PHP
<?php
// Generated by Havoc WEB Panel. Regenerated on every phpMyAdmin install/update.
declare(strict_types=1);
\$cfg['blowfish_secret'] = '$SECRET';   // exactly 32 characters, as phpMyAdmin 5.2 requires
\$cfg['Servers'][1]['auth_type'] = 'cookie';
\$cfg['Servers'][1]['host'] = 'localhost';
\$cfg['Servers'][1]['compress'] = false;
\$cfg['Servers'][1]['AllowNoPassword'] = false;
\$cfg['Servers'][1]['AllowRoot'] = false;
\$cfg['AllowArbitraryServer'] = false;
\$cfg['LoginCookieValidity'] = 3600;
\$cfg['TempDir'] = '$STATE/tmp';
\$cfg['UploadDir'] = '';
\$cfg['SaveDir'] = '';
\$cfg['VersionCheck'] = false;
\$cfg['SendErrorReports'] = 'never';
\$cfg['ShowServerInfo'] = false;
\$cfg['ShowPhpInfo'] = false;
\$cfg['ShowChgPassword'] = true;
\$cfg['PmaNoRelation_DisableWarning'] = true;
\$cfg['NavigationDisplayServers'] = false;
PHP

rm -rf "$DIR.new" && mv "$tmp/x" "$DIR.new"
chown -R root:root "$DIR.new" && chmod -R u=rwX,go=rX "$DIR.new"
chown root:havoc-pma "$DIR.new/config.inc.php" && chmod 640 "$DIR.new/config.inc.php"
rm -rf "$DIR.old"; [ -d "$DIR" ] && mv "$DIR" "$DIR.old"; mv "$DIR.new" "$DIR"; rm -rf "$DIR.old"

cat > /etc/havoc/pma-fpm.conf <<FPM
[global]
pid = /run/havoc-pma-fpm.pid
error_log = /var/log/havoc/panel/pma-fpm.log
daemonize = no
[pma]
user = havoc-pma
group = havoc-pma
listen = /run/havoc-pma.sock
listen.owner = havoc
listen.group = havoc
listen.mode = 0660
pm = ondemand
pm.max_children = 8
pm.process_idle_timeout = 30s
php_admin_value[open_basedir] = $DIR/:$STATE/:/usr/share/php/:/tmp/
php_admin_value[session.save_path] = $STATE/sessions
php_admin_value[upload_tmp_dir] = $STATE/tmp
php_admin_value[upload_max_filesize] = 256M
php_admin_value[post_max_size] = 260M
php_admin_value[memory_limit] = 512M
php_admin_value[max_execution_time] = 600
php_admin_value[disable_functions] = exec,passthru,shell_exec,system,proc_open,popen,pcntl_exec
php_admin_flag[expose_php] = off
php_admin_flag[display_errors] = off
php_admin_value[session.cookie_secure] = 1
FPM

cat > /etc/systemd/system/havoc-pma-fpm.service <<UNIT
[Unit]
Description=phpMyAdmin PHP-FPM (Havoc WEB Panel)
After=network.target mariadb.service

[Service]
ExecStart=/usr/sbin/php-fpm$PHPV --nodaemonize --fpm-config /etc/havoc/pma-fpm.conf
ExecReload=/bin/kill -USR2 \$MAINPID
Restart=on-failure
PrivateTmp=true
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
UNIT

install -d -m 755 /etc/havoc/nginx/conf.d
cat > /etc/havoc/nginx/conf.d/pma.conf <<'NGX'
# phpMyAdmin (Havoc WEB Panel). Only for logged-in panel users: every request is checked against the panel session.
location = /_havoc_auth {
    internal;
    include /etc/nginx/fastcgi_params;
    fastcgi_param SCRIPT_FILENAME /opt/havoc/public/index.php;
    fastcgi_param HTTPS on;
    fastcgi_param HAVOC_AUTH_CHECK 1;
    fastcgi_param CONTENT_LENGTH "";
    fastcgi_pass_request_body off;
    fastcgi_pass unix:/run/havoc-panel.sock;
}
location @havoc_login { return 302 /login; }
location = /phpmyadmin { return 301 /phpmyadmin/; }
location ^~ /phpmyadmin/ {
    auth_request /_havoc_auth;
    error_page 401 = @havoc_login;
    alias /opt/havoc-pma/;
    index index.php;
    client_max_body_size 260m;
    location ~ ^/phpmyadmin/(libraries|templates|vendor|sql|setup|tmp)/ { deny all; }
    location ~ ^/phpmyadmin/(config\.inc\.php|composer\.(json|lock)|package\.json|RELEASE-DATE-.*)$ { deny all; }
    location ~ ^/phpmyadmin/(.+\.php)$ {
        alias /opt/havoc-pma/$1;
        include /etc/nginx/fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /opt/havoc-pma/$1;
        fastcgi_param HTTPS on;
        fastcgi_read_timeout 600s;
        fastcgi_pass unix:/run/havoc-pma.sock;
    }
}
NGX

systemctl daemon-reload
systemctl enable havoc-pma-fpm
systemctl restart havoc-pma-fpm
if ! /usr/sbin/nginx -t -c /etc/havoc/nginx/nginx.conf; then
  rm -f /etc/havoc/nginx/conf.d/pma.conf
  echo "Panel web server configuration test failed; is 'include /etc/havoc/nginx/conf.d/*.conf;' in the server block? Run install/upgrade.sh."
  exit 1
fi
systemctl reload havoc-panel-nginx
VER=$(ls "$DIR" | sed -n 's/^RELEASE-DATE-//p'); echo "phpMyAdmin $VER installed (PHP $PHPV). Open https://<panel>/phpmyadmin/"
